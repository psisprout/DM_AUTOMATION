<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1120</width><height>820</height></rect>
  </property>
  <property name="windowTitle">
   <string>sparabbs - BBS conversion checker</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="rootLayout">
    <item>
     <widget class="QTabWidget" name="tabs">
      <property name="currentIndex"><number>0</number></property>

      <widget class="QWidget" name="tabInput">
       <attribute name="title"><string>1 &#183; Inputs</string></attribute>
       <layout class="QVBoxLayout" name="inputLayout" stretch="0,0,1">
        <item>
         <widget class="QGroupBox" name="boxFiles">
          <property name="title"><string>Files</string></property>
          <layout class="QGridLayout" name="filesGrid">
           <item row="0" column="0">
            <widget class="QLabel" name="lblSnp"><property name="text"><string>Reference (a.snp)</string></property></widget>
           </item>
           <item row="0" column="1"><widget class="QLineEdit" name="editSnp"/></item>
           <item row="0" column="2">
            <widget class="QPushButton" name="btnBrowseSnp"><property name="text"><string>Browse...</string></property></widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="lblBbs"><property name="text"><string>BBS netlist (a_sp.sp)</string></property></widget>
           </item>
           <item row="1" column="1"><widget class="QLineEdit" name="editBbs"/></item>
           <item row="1" column="2">
            <widget class="QPushButton" name="btnBrowseBbs"><property name="text"><string>Browse...</string></property></widget>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="lblOut"><property name="text"><string>Working directory</string></property></widget>
           </item>
           <item row="2" column="1"><widget class="QLineEdit" name="editOutDir"/></item>
           <item row="2" column="2">
            <widget class="QPushButton" name="btnBrowseOut"><property name="text"><string>Browse...</string></property></widget>
           </item>
           <item row="3" column="1">
            <widget class="QPushButton" name="btnLoad"><property name="text"><string>Load and parse</string></property></widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="boxParsed">
          <property name="title"><string>What was read</string></property>
          <layout class="QGridLayout" name="parsedGrid">
           <item row="0" column="0">
            <widget class="QLabel" name="lblSnpCap"><property name="text"><string>Touchstone</string></property></widget>
           </item>
           <item row="0" column="1">
            <widget class="QLabel" name="lblSnpInfo"><property name="text"><string>-</string></property></widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="lblBbsCap"><property name="text"><string>Netlist</string></property></widget>
           </item>
           <item row="1" column="1">
            <widget class="QLabel" name="lblBbsInfo"><property name="text"><string>-</string></property></widget>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="lblZ0Cap"><property name="text"><string>Reference Z0 (ohm)</string></property></widget>
           </item>
           <item row="2" column="1">
            <layout class="QHBoxLayout" name="z0Row">
             <item>
              <widget class="QDoubleSpinBox" name="spinZ0">
               <property name="decimals"><number>4</number></property>
               <property name="minimum"><double>0.000100</double></property>
               <property name="maximum"><double>100000.000000</double></property>
               <property name="value"><double>50.000000</double></property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="lblZ0Src">
               <property name="text"><string>load a file to see where this came from</string></property>
              </widget>
             </item>
             <item><spacer name="z0Spacer"><property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
            </layout>
           </item>
           <item row="3" column="0">
            <widget class="QLabel" name="lblSubcktCap"><property name="text"><string>BBS subcircuit</string></property></widget>
           </item>
           <item row="3" column="1"><widget class="QComboBox" name="comboSubckt"/></item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="boxPins">
          <property name="title">
           <string>Pin to port mapping (worked out automatically)</string>
          </property>
          <layout class="QVBoxLayout" name="pinsLayout" stretch="0,1">
           <item>
            <widget class="QLabel" name="lblMappingNotes">
             <property name="wordWrap"><bool>true</bool></property>
             <property name="text"><string>-</string></property>
            </widget>
           </item>
           <item>
            <widget class="QPlainTextEdit" name="textMapping">
             <property name="readOnly"><bool>true</bool></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>

      <widget class="QWidget" name="tabRun">
       <attribute name="title"><string>2 &#183; Deck &amp;&amp; run</string></attribute>
       <layout class="QVBoxLayout" name="runLayout" stretch="0,0,1,0">
        <item>
         <widget class="QGroupBox" name="boxRunCfg">
          <property name="title"><string>Simulator</string></property>
          <layout class="QGridLayout" name="runGrid">
           <item row="0" column="0">
            <widget class="QLabel" name="lblCmd"><property name="text"><string>Command</string></property></widget>
           </item>
           <item row="0" column="1"><widget class="QLineEdit" name="editCmd"/></item>
           <item row="0" column="2">
            <widget class="QLabel" name="lblCpu"><property name="text"><string>CPUs</string></property></widget>
           </item>
           <item row="0" column="3">
            <widget class="QSpinBox" name="spinCpu">
             <property name="minimum"><number>1</number></property>
             <property name="maximum"><number>256</number></property>
             <property name="value"><number>4</number></property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="lblMaxPts"><property name="text"><string>Max sweep points (0 = all)</string></property></widget>
           </item>
           <item row="1" column="1">
            <widget class="QSpinBox" name="spinMaxPoints">
             <property name="maximum"><number>1000000</number></property>
             <property name="value"><number>0</number></property>
            </widget>
           </item>
           <item row="1" column="2">
            <widget class="QLabel" name="lblWait"><property name="text"><string>Wait for result (min, 0 = forever)</string></property></widget>
           </item>
           <item row="1" column="3">
            <widget class="QSpinBox" name="spinWaitMin">
             <property name="maximum"><number>10080</number></property>
             <property name="value"><number>120</number></property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="lblLin"><property name="text"><string>.LIN options</string></property></widget>
           </item>
           <item row="2" column="1" colspan="3"><widget class="QLineEdit" name="editLinOptions"/></item>
           <item row="3" column="0" colspan="4">
            <widget class="QLabel" name="lblCmdHint">
             <property name="text"><string>Command: {deck} {deck_abs} {cpu} {dir} are substituted.  .LIN options: {base} is the output basename.</string></property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="runButtons">
          <item><widget class="QPushButton" name="btnGenDeck"><property name="text"><string>Generate deck</string></property></widget></item>
          <item><widget class="QPushButton" name="btnRun"><property name="text"><string>Run SPICE</string></property></widget></item>
          <item><widget class="QPushButton" name="btnStop"><property name="text"><string>Stop</string></property>
           <property name="enabled"><bool>false</bool></property></widget></item>
          <item><spacer name="runSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="runSplitter">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <widget class="QGroupBox" name="boxDeck">
           <property name="title"><string>Deck preview</string></property>
           <layout class="QVBoxLayout" name="deckLayout">
            <item><widget class="QPlainTextEdit" name="textDeck"/></item>
           </layout>
          </widget>
          <widget class="QGroupBox" name="boxLog">
           <property name="title"><string>Run log</string></property>
           <layout class="QVBoxLayout" name="logLayout">
            <item><widget class="QPlainTextEdit" name="textLog"/></item>
           </layout>
          </widget>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="resultRow">
          <item><widget class="QLabel" name="lblResult"><property name="text"><string>S-parameters produced</string></property></widget></item>
          <item><widget class="QLineEdit" name="editResultSnp"/></item>
          <item><widget class="QPushButton" name="btnBrowseResult"><property name="text"><string>Browse...</string></property></widget></item>
         </layout>
        </item>
       </layout>
      </widget>

      <widget class="QWidget" name="tabRef">
       <attribute name="title"><string>3 &#183; Reference node</string></attribute>
       <layout class="QVBoxLayout" name="refLayout" stretch="0,0,1,0">
        <item>
         <widget class="QLabel" name="lblRefIntro">
          <property name="wordWrap"><bool>true</bool></property>
          <property name="text">
           <string>Choose how the raw N-port is referenced before Z is computed. The same transform is applied to both networks, so the comparison stays like-for-like.</string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="refModeRow">
          <item><widget class="QLabel" name="lblRefMode"><property name="text"><string>Mode</string></property></widget></item>
          <item><widget class="QComboBox" name="comboRefMode"/></item>
          <item><spacer name="refSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
         </layout>
        </item>
        <item>
         <widget class="QGroupBox" name="boxRefPorts">
          <property name="title"><string>Ports</string></property>
          <layout class="QVBoxLayout" name="refPortsLayout">
           <item><widget class="QListWidget" name="listRefPorts"/></item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lblRefDesc">
          <property name="wordWrap"><bool>true</bool></property>
          <property name="text"><string>-</string></property>
         </widget>
        </item>
       </layout>
      </widget>

      <widget class="QWidget" name="tabCompare">
       <attribute name="title"><string>4 &#183; Compare &amp;&amp; report</string></attribute>
       <layout class="QVBoxLayout" name="cmpLayout" stretch="0,0,1">
        <item>
         <widget class="QGroupBox" name="boxCriteria">
          <property name="title"><string>Pass / fail criteria</string></property>
          <layout class="QGridLayout" name="critGrid">
           <item row="0" column="0"><widget class="QLabel" name="lblMagErr"><property name="text"><string>max |Z| error (% of band peak)</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinMagErr">
            <property name="maximum"><double>1000.000000</double></property><property name="value"><double>5.000000</double></property></widget></item>
           <item row="0" column="2"><widget class="QLabel" name="lblErrDb"><property name="text"><string>max error (dB)</string></property></widget></item>
           <item row="0" column="3"><widget class="QDoubleSpinBox" name="spinErrDb">
            <property name="decimals"><number>3</number></property><property name="maximum"><double>100.000000</double></property>
            <property name="value"><double>0.500000</double></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lblPhase"><property name="text"><string>max phase error (deg)</string></property></widget></item>
           <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinPhase">
            <property name="maximum"><double>180.000000</double></property><property name="value"><double>5.000000</double></property></widget></item>
           <item row="1" column="2"><widget class="QLabel" name="lblPeakShift"><property name="text"><string>max peak shift (%)</string></property></widget></item>
           <item row="1" column="3"><widget class="QDoubleSpinBox" name="spinPeakShift">
            <property name="maximum"><double>1000.000000</double></property><property name="value"><double>2.000000</double></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="lblPeakMag"><property name="text"><string>max peak |Z| error (%)</string></property></widget></item>
           <item row="2" column="1"><widget class="QDoubleSpinBox" name="spinPeakMag">
            <property name="maximum"><double>1000.000000</double></property><property name="value"><double>10.000000</double></property></widget></item>
           <item row="2" column="2"><widget class="QLabel" name="lblAlign"><property name="text"><string>Frequency grid</string></property></widget></item>
           <item row="2" column="3"><widget class="QComboBox" name="comboAlign"/></item>
           <item row="3" column="0" colspan="2">
            <widget class="QCheckBox" name="chkGateChecks">
             <property name="text"><string>Fail on passivity / reciprocity violations</string></property>
            </widget>
           </item>
           <item row="3" column="2" colspan="2">
            <widget class="QCheckBox" name="chkFullMatrix">
             <property name="text"><string>Compare the full matrix, not just the upper triangle</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="cmpButtons">
          <item><widget class="QPushButton" name="btnCompare"><property name="text"><string>Compare</string></property></widget></item>
          <item><widget class="QPushButton" name="btnSaveXml"><property name="text"><string>Save XML...</string></property></widget></item>
          <item><widget class="QPushButton" name="btnSaveJunit"><property name="text"><string>Save JUnit XML...</string></property></widget></item>
          <item><widget class="QPushButton" name="btnPlot"><property name="text"><string>Plot selected term</string></property></widget></item>
          <item><widget class="QLabel" name="lblVerdict"><property name="text"><string>-</string></property></widget></item>
          <item><spacer name="cmpSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property>
           <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
         </layout>
        </item>
        <item>
         <widget class="QSplitter" name="cmpSplitter">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <widget class="QTreeWidget" name="treeResult">
           <column><property name="text"><string>Term</string></property></column>
          </widget>
          <widget class="QPlainTextEdit" name="textXml">
           <property name="readOnly"><bool>true</bool></property>
          </widget>
         </widget>
        </item>
       </layout>
      </widget>

     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <resources/>
 <connections/>
</ui>
