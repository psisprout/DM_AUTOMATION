#!/usr/bin/env python3
"""Start the MCP server from anywhere: python3.11 /path/to/primesim-dm/primesim-dm-mcp

Same idea as the primesim-dm launcher: the package stays importable without
installing it, so an MCP client's config only needs this one path.  Run it
with a Python 3.10+ that has the mcp package.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from primesim_dm.mcp_server import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
